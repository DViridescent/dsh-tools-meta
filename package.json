{
  "name": "dsh-tools-meta",
  "version": "0.1.2",
  "description": "元工具：以文件为载体制建、修改、移除模型自己的持久化工具（插件 + skill，零模型工具）。Meta tools: the model creates/modifies/removes its own persistent tools as TS module files (plugin + skill, no model-facing tools).",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/runner.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "meta",
    "tools",
    "self-modification",
    "code-runtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DViridescent/dsh-tools-meta.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "0.1.0-rc.6"
  },
  "license": "MIT"
}
