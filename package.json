{
  "name": "dsh-tools-meta",
  "version": "0.1.0",
  "description": "元工具：让模型为自己的会话即时注册/卸载带 schema 的工具（node 脚本经 codeRuntime 隔离执行）。Meta tools: the model registers/unregisters session-scoped, schema-typed tools backed by node scripts.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "src/runner.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "meta",
    "tools",
    "self-modification",
    "code-runtime"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DViridescent/dsh-tools-meta.git"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-home-paths": "^0.1.0-rc.6"
  },
  "license": "MIT"
}
